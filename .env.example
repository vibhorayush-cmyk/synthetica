APP_NAME="Synthetic Analytics Platform"
ENVIRONMENT=production
DEBUG=false
DATABASE_URL="sqlite:///./data/app.db"
EXPORT_DIR="./exports"
HISTORY_DIR="./history"
TEMPLATE_DIR="./templates"
SECRET_KEY="replace-with-a-long-random-secret"
CORS_ORIGINS='["http://localhost:3000"]'
MAX_DATASET_ROWS=1000000
MAX_CUSTOMERS=25000
MAX_PRODUCTS=2000
MAX_STORES=250
MAX_ORDERS=100000
MAX_TOTAL_ROWS=500000
GENERATION_TIMEOUT_SECONDS=90
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
GENERATION_RATE_LIMIT_REQUESTS=5
GENERATION_RATE_LIMIT_WINDOW_SECONDS=60
EXPORT_TTL_HOURS=2
MAX_EXPORT_STORAGE_MB=500
LOG_LEVEL=INFO
